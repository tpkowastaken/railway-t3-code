#!/usr/bin/env python3
"""Put the given markdown file at the top of every agent's global instructions.

The text sits between marker comments and is replaced on every boot, so an
image update reaches existing volumes. Anything outside the markers (a user's
own instructions) is left alone.
"""
import os
import re
import sys

# Global instruction files, relative to $HOME, for the agents T3 Code runs.
TARGETS = [
    ".claude/CLAUDE.md",  # Claude Code
    ".codex/AGENTS.md",  # Codex
    ".config/opencode/AGENTS.md",  # OpenCode 1.x and 2.x
    ".gemini/GEMINI.md",  # Antigravity, Gemini CLI (ACP)
    ".pi/agent/AGENTS.md",  # Pi
    ".fx/AGENTS.md",  # fx
]

BEGIN = "<!-- BEGIN railway-t3-code: rewritten on every boot, edit outside this block -->"
END = "<!-- END railway-t3-code -->"
managed = re.compile(re.escape(BEGIN) + r".*?" + re.escape(END) + r"\n*", re.S)

with open(sys.argv[1]) as f:
    block = f"{BEGIN}\n{f.read().strip()}\n{END}\n"

home = os.path.expanduser("~")

# Claude and Codex share one file so edits made by either agent stay in sync.
shared = os.path.join(home, ".codex/AGENTS.md")
claude = os.path.join(home, ".claude/CLAUDE.md")
os.makedirs(os.path.dirname(shared), exist_ok=True)
os.makedirs(os.path.dirname(claude), exist_ok=True)
if not (os.path.exists(shared) and os.path.exists(claude)
        and os.path.samefile(shared, claude)):
    instructions = []
    for path in (shared, claude):
        try:
            with open(path) as f:
                rest = managed.sub("", f.read()).strip("\n")
        except FileNotFoundError:
            continue
        if rest and rest not in instructions:
            instructions.append(rest)
    with open(shared, "w") as f:
        f.write("\n\n".join(instructions))
    if os.path.lexists(claude):
        # Keep the original file (or link) when migrating an existing volume.
        backup = claude + ".before-shared"
        suffix = 1
        while os.path.lexists(backup):
            backup = claude + f".before-shared.{suffix}"
            suffix += 1
        os.rename(claude, backup)
    os.symlink(os.path.relpath(shared, os.path.dirname(claude)), claude)

for rel in TARGETS:
    path = os.path.join(home, rel)
    try:
        with open(path) as f:
            old = f.read()
    except FileNotFoundError:
        old = ""
    rest = managed.sub("", old).lstrip("\n")
    new = block + ("\n" + rest if rest else "")
    if new != old:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            f.write(new)
